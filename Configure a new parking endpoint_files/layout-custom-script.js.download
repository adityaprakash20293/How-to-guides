$(document).ready(function () {
  changeLabel();
  $(document).ajaxComplete(function () {
    changeLabel();
  });
});

function changeLabel() {
  $('*[lang=en] .caution .title').text(
    'CAUTION! Failure to follow these instructions may result in MINOR or MODERATE INJURY or DAMAGE to the system or property.'
  );
  $('*[lang=en] .warning .title').text(
    'WARNING! Failure to follow these instructions may result in SERIOUS INJURY, INCLUDING DEATH.'
  );
  $('*[lang=en] .danger .title').text(
    'DANGER! Failure to follow these instructions WILL result in SERIOUS INJURY, INCLUDING DEATH.'
  );
  $('*[lang=en] .important .title').text('IMPORTANT');

  $('*[lang=de] .caution .title').text(
    'VORSICHT! Die Nichteinhaltung dieser Anweisungen kann zu GERINGFÜGIGEN oder MITTELSCHWEREN VERLETZUNGEN oder zu SYSTEM- bzw. SACHSCHÄDEN führen.'
  );
  $('*[lang=de] .warning .title').text(
    'WARNUNG! Die Nichteinhaltung dieser Anweisungen kann zu LEBENSGEFÄHRLICHEN VERLETZUNGEN oder zum TOD führen.'
  );
  $('*[lang=de] .danger .title').text(
    'GEFAHR! Die Nichteinhaltung dieser Anweisungen WIRD zu LEBENSGEFÄHRLICHEN VERLETZUNGEN oder zum TOD führen.'
  );
  $('*[lang=de] .important .title').text('WICHTIG');

  $('*[lang=ja] .caution .title').text(
    '注意！この指示に従わないと、軽度または中程度の負傷や、システムまたは物品の損害を引き起こす可能性があります。'
  );
  $('*[lang=ja] .warning .title').text(
    '警告！この指示に従わないと、死亡を含む重傷を引き起こす可能性があります。'
  );
  $('*[lang=ja] .danger .title').text(
    '危険！この指示に従わないと、死亡を含む重傷を引き起こします。'
  );
  $('*[lang=ja] .important .title').text('重要');

  $('*[lang=nl] .caution .title').text(
    'LET OP! Het niet opvolgen van deze instructies kan leiden tot LICHT of MIDDELZWAAR LETSEL of SCHADE aan het systeem of eigendommen.'
  );
  $('*[lang=nl] .warning .title').text(
    'WAARSCHUWING! Het niet opvolgen van deze instructies kan leiden tot ERNSTIG OF ZELFS DODELIJK LETSEL.'
  );
  $('*[lang=nl] .danger .title').text(
    'GEVAAR! Het niet opvolgen van deze instructies ZAL leiden tot ERNSTIG OF ZELFS DODELIJK LETSEL.'
  );
  $('*[lang=nl] .important .title').text('BELANGRIJK');
}

$(document).ready(function () {
  var searchBtn =
    '<button type="submit" class="btn">' +
    '<i class="fa fa-search">' +
    '</i>' +
    '</button>';
  $(searchBtn).insertAfter('form.site-sidebar-search .search-field');
  $(document).ajaxComplete(function () {
    var searchBtn =
      '<button type="submit" class="btn">' +
      '<i class="fa fa-search">' +
      '</i>' +
      '</button>';
    $(searchBtn).insertAfter('form.site-sidebar-search .search-field');
  });
});

