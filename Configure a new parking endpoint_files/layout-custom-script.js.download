// Portal page custom intro text

$(document).ready(function () {
    setWelcomeText();
    $(document).ajaxComplete(function () {
    setWelcomeText();
    });
});

function setWelcomeText(){
    for (var key in welcomeTextDict) {
        var element = $("header.portal-header[data-portal-language=" + key +"] h1");
        element.text(welcomeTextDict[key])
    }
}
var welcomeTextDict = { "en" : "Welcome to OTTO Technical Documentation"};

// Portal page custom tile images

$(document).ready(function() {

var icon1 = "https://docs.ottomotors.com/Files/new/GettingStarted.svg";
var icon2 = "https://docs.ottomotors.com/Files/new/Software3.svg";
var icon3 = "https://docs.ottomotors.com/Files/new/fleetmanager.svg";
var icon4 = "https://docs.ottomotors.com/Files/new/whatsnew.svg";
var icon5 = "https://docs.ottomotors.com/Files/new/Hardware.svg";
var icon6 = "https://docs.ottomotors.com/Files/new/Attachments.svg";
var icon7 = "https://docs.ottomotors.com/Files/new/How-To.svg";
var icon8 = "https://docs.ottomotors.com/Files/new/Manuals.svg";

$(".cat-panel-1").closest("a").prepend("<img src='" + icon1 + "'></img>");
$(".cat-panel-2").closest("a").prepend("<img src='" + icon2 + "'></img>");
$(".cat-panel-3").closest("a").prepend("<img src='" + icon3 + "'></img>");
$(".cat-panel-4").closest("a").prepend("<img src='" + icon4 + "'></img>");
$(".cat-panel-5").closest("a").prepend("<img src='" + icon5 + "'></img>");
$(".cat-panel-6").closest("a").prepend("<img src='" + icon6 + "'></img>");
$(".cat-panel-7").closest("a").prepend("<img src='" + icon7 + "'></img>");
$(".cat-panel-8").closest("a").prepend("<img src='" + icon8 + "'></img>");

$(".publication-icon").remove();

});